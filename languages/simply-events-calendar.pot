#: includes/class-docs.php:115
#: includes/class-docs.php:131
msgid "\"yes\"/\"no\" — show the \"Learn More\" footer link."
msgstr ""

#: includes/class-docs.php:120
msgid "Single event — [sec_event]"
msgstr ""

#: includes/class-docs.php:124
msgid "Displays one specific event by its ID, as a card or an image-left list row. The \"id\" attribute is required — find the ID in the URL when editing the event (post=123)."
msgstr ""

#: includes/class-docs.php:126
msgid "Required. The event's post ID."
msgstr ""

#: includes/class-docs.php:127
msgid "\"card\" (default) or \"list\" (image left, details right)."
msgstr ""

#: includes/class-docs.php:128
msgid "\"yes\"/\"no\" — show the event time."
msgstr ""

#: includes/class-docs.php:129
msgid "\"yes\"/\"no\" — show the excerpt."
msgstr ""

#: includes/class-docs.php:130
msgid "\"yes\"/\"no\" — show the location."

# Install behaviour. The cache location is deliberately not pinned here: npm
# already defaults to %LOCALAPPDATA%\npm-cache on Windows, which is off this
# repo's drive, and hardcoding an absolute user path only breaks on other machines.
prefer-offline=true
audit=false
fund=false
progress=false

# Reduce concurrent operations
maxsockets=1

# Registry settings
registry=https://registry.npmjs.org/